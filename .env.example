# Required: your Garmin Connect credentials
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Required for production: bearer token clients must send
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Optional: base64-encoded tar.gz of a local ~/.garminconnect tokenstore.
# Use bootstrap_tokens.py to generate (handles MFA interactively once).
# Lets the server skip the password+MFA dance on every cold start.
GARMINTOKENS_BASE64=

# Optional overrides
PORT=8000
HOST=0.0.0.0
MCP_PATH=/mcp
LOG_LEVEL=INFO
