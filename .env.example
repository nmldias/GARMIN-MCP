# Garmin Connect credentials.
# Only needed if GARMINTOKENS_BASE64 is NOT set. If you provide a token
# blob below, leave these blank — the server runs purely on the tokens.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional: bearer token clients must send. Note: claude.ai's custom
# connector UI does not support static bearer tokens — leave blank there.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Preferred auth: base64-encoded tar.gz of a local ~/.garminconnect
# tokenstore. Use bootstrap_tokens.py to generate (handles MFA once).
# With this set, GARMIN_EMAIL/GARMIN_PASSWORD are not required.
GARMINTOKENS_BASE64=

# Optional overrides
PORT=8000
HOST=0.0.0.0
MCP_PATH=/mcp
LOG_LEVEL=INFO
